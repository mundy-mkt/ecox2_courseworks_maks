# R project user settings and caches
.Rhistory
.RData
.Ruserdata
.Rproj.user/

# R package/library caches and project-local libraries
*library/            # local package library (if you create one) - binary packages, large and machine-specific
local/              # sometimes used for local builds or caches
cellar/             # (optional) custom package cache folder used by some setups

# Lock, staging and temporary directories (generic)
lock/               # lock files or folders used by build tools
staging/            # temporary staging area for packaging/building
sandbox/            # sandbox environment / temp files used during testing
